# Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# OpenAI API Key (from https://platform.openai.com/api-keys)
# Note: Photo Quiz feature uses gpt-4o (vision). Make sure your API key has access.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL Database URL (Railway, Supabase, or local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/english_learning

# NextAuth.js Secret (generate with: openssl rand -hex 32)
AUTH_SECRET=

# Google OAuth (from https://console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
